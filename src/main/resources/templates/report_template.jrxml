<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="report_template" pageWidth="595" pageHeight="842" 
              columnWidth="555" leftMargin="20" rightMargin="20" 
              topMargin="20" bottomMargin="20">
    
    <!-- Parameters - automatically populated from JSON message -->
    <parameter name="MESSAGE_DATA" class="java.lang.String"/>
    <parameter name="GENERATION_TIME" class="java.lang.String"/>
    <parameter name="REPORT_TITLE" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["Nyx Jasper Report"]]></defaultValueExpression>
    </parameter>
    <parameter name="CUSTOMER_NAME" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["N/A"]]></defaultValueExpression>
    </parameter>
    <parameter name="ORDER_ID" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["N/A"]]></defaultValueExpression>
    </parameter>
    <parameter name="ORDER_DATE" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["N/A"]]></defaultValueExpression>
    </parameter>
    <parameter name="TOTAL_AMOUNT" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["0.00"]]></defaultValueExpression>
    </parameter>
    
    <!-- Title Band -->
    <title>
        <band height="100">
            <textField>
                <reportElement x="0" y="0" width="555" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="24" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="45" width="555" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="60" width="100" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Generated:]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="60" width="455" height="20"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{GENERATION_TIME}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    
    <!-- Page Header -->
    <pageHeader>
        <band height="30">
            <staticText>
                <reportElement x="0" y="0" width="555" height="25"/>
                <box>
                    <pen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[Order Information]]></text>
            </staticText>
        </band>
    </pageHeader>
    
    <!-- Detail Band -->
    <detail>
        <band height="250">
            <!-- Customer Name -->
            <staticText>
                <reportElement x="10" y="20" width="150" height="25"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Customer Name:]]></text>
            </staticText>
            <textField>
                <reportElement x="170" y="20" width="375" height="25"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CUSTOMER_NAME}]]></textFieldExpression>
            </textField>
            
            <!-- Order ID -->
            <staticText>
                <reportElement x="10" y="55" width="150" height="25"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Order ID:]]></text>
            </staticText>
            <textField>
                <reportElement x="170" y="55" width="375" height="25"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{ORDER_ID}]]></textFieldExpression>
            </textField>
            
            <!-- Order Date -->
            <staticText>
                <reportElement x="10" y="90" width="150" height="25"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Order Date:]]></text>
            </staticText>
            <textField>
                <reportElement x="170" y="90" width="375" height="25"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{ORDER_DATE}]]></textFieldExpression>
            </textField>
            
            <!-- Total Amount -->
            <staticText>
                <reportElement x="10" y="125" width="150" height="25"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Total Amount:]]></text>
            </staticText>
            <textField>
                <reportElement x="170" y="125" width="375" height="25"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["$" + $P{TOTAL_AMOUNT}]]></textFieldExpression>
            </textField>
            
            <!-- Message Data (for debugging) -->
            <staticText>
                <reportElement x="10" y="170" width="150" height="25"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Raw Message Data:]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement x="10" y="200" width="535" height="40"/>
                <box padding="5">
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </box>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{MESSAGE_DATA}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <!-- Page Footer -->
    <pageFooter>
        <band height="30">
            <line>
                <reportElement x="0" y="5" width="555" height="1"/>
            </line>
            <textField>
                <reportElement x="0" y="10" width="200" height="20"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Nyx Jasper Creator v1.0"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="455" y="10" width="100" height="20"/>
                <textElement textAlignment="Right">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
    
</jasperReport>
